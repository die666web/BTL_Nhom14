              <FilePath>..\drivers\src\button.c</FilePath>
            </File>
            <File>
              <FileName>ina219.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\drivers\src\ina219.c</FilePath>
            </File>
            <File>
              <FileName>oled.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\drivers\src\oled.c</FilePath>
            </File>
            <File>
              <FileName>relay.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\drivers\src\relay.c</FilePath>
            </File>
          </Files>
        </Group>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File>
              <FileName>app_ipc.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\app\src\app_ipc.c</FilePath>
            </File>
            <File>
              <FileName>rtos_hooks.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\app\src\rtos_hooks.c</FilePath>
            </File>
            <File>
              <FileName>task_comm.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\app\src\task_comm.c</FilePath>
            </File>
            <File>
              <FileName>task_control.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\app\src\task_control.c</FilePath>
            </File>
            <File>
              <FileName>task_display.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\app\src\task_display.c</FilePath>
            </File>
            <File>
              <FileName>task_measure.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\app\src\task_measure.c</FilePath>
            </File>
          </Files>
        </Group>
        <Group>
          <GroupName>FreeRTOS</GroupName>
          <Files>
            <File>
              <FileName>tasks.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\middlewares\FreeRTOS-Kernel\tasks.c</FilePath>
            </File>
            <File>
              <FileName>list.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\middlewares\FreeRTOS-Kernel\list.c</FilePath>
            </File>
            <File>
              <FileName>queue.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\middlewares\FreeRTOS-Kernel\queue.c</FilePath>
            </File>
            <File>
              <FileName>timers.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\middlewares\FreeRTOS-Kernel\timers.c</FilePath>
