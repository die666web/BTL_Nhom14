; APPLICATION sau bootloader: Flash 0x08002000, 55 KiB (tới 0x0800FC00 = metadata), RAM 20 KiB.
; Khớp common/ota_frame/ota_layout.h. Bảng vector phải nằm đầu ảnh (startup.o +First).
; ARM Compiler 6 full C runtime (__main). Do not enable MicroLIB.
LR_IROM1 0x08002000 0x0000DC00 {
  ER_IROM1 0x08002000 0x0000DC00 {
    startup.o (.isr_vector, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00004A00 { .ANY (+RW +ZI) }
  ARM_LIB_HEAP 0x20004A00 EMPTY 0x00000200 { }
  ARM_LIB_STACK 0x20005000 EMPTY -0x00000400 { }
}
